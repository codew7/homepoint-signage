{
  "name": "homepoint-led",
  "productName": "HomePoint LED",
  "version": "1.0.0",
  "description": "Salida LED de HomePoint (led.html) como app de Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.homepoint.led",
    "productName": "HomePoint LED",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      { "from": "..", "to": ".", "filter": ["led.html"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HomePoint LED"
    }
  }
}
