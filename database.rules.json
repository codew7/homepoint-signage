{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'",
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'superadmin' || newData.val() === 'manager' || newData.val() === 'player')"
        },
        "stores": {
          "$storeId": { ".validate": "newData.isBoolean()" }
        },
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "lastLogin": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "storeList": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'",
      "$storeId": {
        ".validate": "$storeId.matches(/^[a-z0-9_-]{1,40}$/) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60"
      }
    },

    "stores": {
      "$storeId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('stores').child($storeId).val() === true)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || (root.child('users').child(auth.uid).child('role').val() === 'manager' && root.child('users').child(auth.uid).child('stores').child($storeId).val() === true))"
      }
    },

    "mediaUsage": {
      ".read": "auth != null",
      "$storeId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || (root.child('users').child(auth.uid).child('role').val() === 'manager' && root.child('users').child(auth.uid).child('stores').child($storeId).val() === true))",
        ".validate": "root.child('storeList').child($storeId).exists() && newData.hasChild('updatedAt')"
      }
    },

    "screens": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'"
    },
    "shared": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'"
    }
  }
}
